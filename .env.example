# JudgeAndJury — project credentials (SwarmHack)
#
#   cp .env.example .env    then fill in the values below.
#
# .env is GIT-IGNORED. Never commit real keys — a key in the repo is a
# leaked key. Anything you export in your shell overrides this file, so
# CI secrets and one-off overrides keep working.
#
# Loaded automatically by every `proofjury` command (cli.py `_bootstrap`).
# Only the keys below plus PROOFJURY_* are read — see
# config.PROJECT_ENV_KEYS. That allowlist exists so a repo file can never
# inject arbitrary environment into the deploy context the env_vars check
# evaluates.

# ── Pioneer — inference for every LLM surface (H1) + fine-tuning (H2) ──
# Sign up at https://agent.pioneer.ai, promo code HACKATHONSF0724 for the
# free Pro plan + inference credits.
PIONEER_API_KEY=

# Pin Pioneer as THE provider rather than relying on autodetect order —
# otherwise a stray OPENROUTER_API_KEY in your shell would win.
PROOFJURY_JUDGE_PROVIDER=pioneer

# Pioneer/Auto is the model router: every prompt goes to the best model
# for that job across 70+ open and frontier models, and the platform's
# Routers page reports the savings vs always calling a frontier model.
# Swap for a specific catalog id, or for a tuned job id after
# `proofjury memory finetune` completes.
PROOFJURY_JUDGE_MODEL=Pioneer/Auto

# ── Actian VectorAI DB — semantic recall (H3) ─────────────────────────
# Community Edition runs LOCALLY and listens on host:port (it is a local
# server, not a file-backed store), so vectors never leave the machine.
#   pip install -e 'cli[semantic]'
ACTIAN_VECTOR_URL=localhost:6574

# ── Senso — authored team conventions (H5) ────────────────────────────
# Off unless [conventions] enabled = true in .proofjury.toml.
SENSO_API_KEY=
SENSO_KB_ID=

# ── Replay — browser QA as a gate check (H4) ──────────────────────────
# The check reads the run recorded by `proofjury run qa -- <cmd>`; this
# key is only for the Replay CLI/API itself.
REPLAY_API_KEY=
