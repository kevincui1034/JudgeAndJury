# ── Database ──────────────────────────────────────────────────────────
# Local dev: docker compose up -d (Postgres on 54329), then copy to .env.local
DATABASE_URL=postgres://proofjury:proofjury@localhost:54329/proofjury
# Production (Supabase): use the TRANSACTION POOLER url (port 6543) for the
# app runtime; run migrations against the DIRECT/session url (port 5432).
# With the default Postgres blob driver this is the ONLY service you need.
# Managed Postgres needs TLS — it's auto-enabled for non-local hosts.
# DATABASE_SSL=disable        # force TLS off (local only)
# DATABASE_SSL_CA=            # PEM to verify the provider CA strictly

# ── Auth.js ───────────────────────────────────────────────────────────
# AUTH_SECRET: `npx auth secret` (any random string in dev).
AUTH_SECRET=dev-secret-change-me
# GitHub OAuth app (production; omit in dev — use the dev login instead)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Dev-only credentials login (never active in production builds)
AUTH_DEV_LOGIN=1

# ── Proof-file storage ────────────────────────────────────────────────
# DEFAULT: Postgres. Proof files live in the `proof_blobs` table, so a
# deployment needs no second vendor and no blob credentials at all. Size
# is bounded upstream (the CLI truncates each file at 1 MB, ingest rejects
# bodies over 4 MB), so this is comfortably within what Postgres handles.
#
# Leave BLOB_DRIVER unset for automatic selection:
#   object storage configured -> S3     (see below)
#   DATABASE_URL present      -> postgres
#   otherwise                 -> local
# Or force one explicitly: local | postgres | s3
# BLOB_DRIVER=postgres

# Optional object storage (any S3-compatible service). Only needed if you
# would rather keep blobs out of the database.
#
# Supabase Storage — the endpoint is derived from SUPABASE_URL:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_STORAGE_BUCKET=proofs
# SUPABASE_STORAGE_KEY_ID=          # Storage settings -> S3 access keys
# SUPABASE_STORAGE_ACCESS_KEY=
#
# Cloudflare R2 / MinIO / any S3 (the original R2_* names still work):
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=proofs
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=true     # required by Supabase Storage + MinIO

APP_URL=http://localhost:3000
